# Copy this file to .env and fill in the real value — .env is gitignored,
# .env.example is committed so the shape of what's needed is documented.

# From the Neon dashboard: Project → Connection Details → "Direct connection"
# (not "Pooled connection" — Alembic's DDL can behave unpredictably through
# pgbouncer's transaction pooling mode, so both the app and migrations use
# the direct string here).
DATABASE_URL=postgresql://user:password@ep-xxxxx.eu-central-1.aws.neon.tech/ridemeet?sslmode=require
